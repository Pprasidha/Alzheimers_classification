{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "1. Launch Web Dashboard",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/app/server.py",
            "console": "integratedTerminal"
        },
        {
            "name": "2. Predict Sample MRI Scan (Grad-CAM)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/predict.py",
            "args": [
                "--image",
                "${workspaceFolder}/data/mri_dataset/MildDemented/real_test_00001.jpg"
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "3. Evaluate Model on Test Set",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/evaluate.py",
            "console": "integratedTerminal"
        },
        {
            "name": "4. Train AlzheimerNet CNN",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--epochs", "10",
                "--batch_size", "32"
            ],
            "console": "integratedTerminal"
        }
    ]
}
